<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_prescription_wizard_form" model="ir.ui.view">
        <field name="name">hms.prescription.wizard.form</field>
        <field name="model">hms.prescription.wizard</field>
        <field name="arch" type="xml">
            <form string="Doctor Prescription">
                    <group>
                        <field name="disease_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="medicine_id" required="1"/>
                                <field name="dosage" required="1"/>
                                <field name="instruction"/>
                            </tree>
                        </field>
                    </group>
                <footer>
                    <button name="action_done"
                            string="Save Complete"
                            type="object"
                            class="btn-primary"/>
            
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>