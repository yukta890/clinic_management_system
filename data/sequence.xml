<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Patient Sequence -->
        <record id="seq_hms_patient" model="ir.sequence">
            <field name="name">HMS Patient</field>
            <field name="code">hms.patient</field>
            <field name="prefix">PAT-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"></field>
        </record>

        <!-- Followup Sequence -->
        <record id="seq_hms_followup" model="ir.sequence">
            <field name="name">Followup Sequence</field>
            <field name="code">hms.followup.seq</field>
            <field name="prefix">FLW/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"></field>
        </record>

        <!-- Appointment Sequence -->
        <record id="seq_hms_appointment" model="ir.sequence">
            <field name="name">Appointment Sequence</field>
            <field name="code">hms.appointment</field>
            <field name="prefix">APT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"></field>
        </record>

        <!-- Drug Sequence -->
        <record id="seq_hms_drug" model="ir.sequence">
            <field name="name">Drug Sequence</field>
            <field name="code">hms.drug</field>
            <field name="prefix">DRG/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"></field>
        </record>

    </data>
</odoo>